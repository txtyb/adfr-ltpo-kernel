+static unsigned int oplus_adfr_get_sa_floor(struct dsi_panel *panel)
+{
+	unsigned int i = 0;
+	unsigned int bl_level = panel->bl_config.bl_level;
+	struct oplus_adfr_params *p_oplus_adfr_params = oplus_adfr_get_params(panel);
+
+	for (i = 0; i < p_oplus_adfr_params->sa_min_fps_bl_table_count; i++) {
+		if (bl_level < p_oplus_adfr_params->sa_min_fps_bl_table[2 * i])
+			continue;
+		if (!p_oplus_adfr_params->sa_min_fps_bl_table[2 * i + 1])
+			return panel->cur_mode->timing.refresh_rate;
+		return p_oplus_adfr_params->sa_min_fps_bl_table[2 * i + 1];
+	}
+
+	return panel->qsync_caps.qsync_min_fps;
+}
+
+static int oplus_adfr_sa_floor_update(struct dsi_panel *panel, unsigned int qsync_mode)
+{
+	unsigned int auto_mode = OPLUS_ADFR_AUTO_OFF;
+	unsigned int min_fps = 0;
+	struct dsi_display_mode_priv_info *priv_info = NULL;
+	struct oplus_adfr_params *p_oplus_adfr_params = oplus_adfr_get_params(panel);
+
+	if (!p_oplus_adfr_params || !panel->cur_mode || !panel->cur_mode->priv_info) {
+		ADFR_ERR("invalid panel params\n");
+		return -EINVAL;
+	}
+
+	priv_info = panel->cur_mode->priv_info;
+	min_fps = panel->cur_mode->timing.refresh_rate;
+	/*
+	 * LineageOS only enables qsync while ARR is active, and ARR is what keeps
+	 * the SoC out of s2idle on this device, so do not gate the floor on qsync:
+	 * whenever the panel declares a backlight table, drive the floor from it.
+	 * The lookup already falls back to "keep the mode rate" when nothing
+	 * matches, so a bare table cannot pin the panel low by accident.
+	 */
+	if (priv_info->oplus_adfr_min_fps_mapping_table_count &&
+			p_oplus_adfr_params->sa_min_fps_bl_table_count) {
+		auto_mode = OPLUS_ADFR_AUTO_ON;
+		min_fps = oplus_adfr_get_sa_floor(panel);
+		if (min_fps < priv_info->oplus_adfr_min_fps_mapping_table[priv_info->oplus_adfr_min_fps_mapping_table_count - 1])
+			min_fps = priv_info->oplus_adfr_min_fps_mapping_table[priv_info->oplus_adfr_min_fps_mapping_table_count - 1];
+	}
+
+	if (auto_mode != p_oplus_adfr_params->auto_mode) {
+		p_oplus_adfr_params->auto_mode = auto_mode;
+		p_oplus_adfr_params->auto_mode_updated = true;
+		p_oplus_adfr_params->sa_min_fps_updated = true;
+	}
+
+	if (min_fps != p_oplus_adfr_params->sa_min_fps) {
+		p_oplus_adfr_params->sa_min_fps = min_fps;
+		p_oplus_adfr_params->sa_min_fps_updated = true;
+	}
+
+	return 0;
+}
+
+
+/*
+ * ---------------------------------------------------------------------------
+ * Kernel-side LTPO: keep ADFR auto mode armed with a low SA min-fps floor.
+ *
+ * On OxygenOS this state is driven from userspace. oplus_adfr_init (the
+ * vendor display service) sends the OPLUS auto-ADFR control word
+ * 0x5cc18181 through the QTI composer; display-core turns it into a write of
+ * the connector's "qsync_min_fps" DRM property, and this driver decodes it as
+ * auto_mode = OPLUS_ADFR_AUTO_ON with an SA min fps of 1.
+ *
+ * LineageOS ships neither the service nor the HAL patches. The generic QSync
+ * property its composer does send is dropped by sde_connector whenever the
+ * panel runs OA fixed TE, so auto mode is never enabled and the panel stays
+ * at the mode refresh rate for good.
+ *
+ * Instead of waiting for a hint that never arrives, derive the floor from the
+ * panel backlight table (oplus,adfr-sa-min-fps-bl-table) and keep auto mode
+ * armed across timing switches. From then on the panel hardware handles the
+ * idle transitions itself: full rate while frames arrive, floor when they do
+ * not. No userspace daemon and no polling loop are involved.
+ *
+ * Runtime control:
+ *   /sys/module/msm_drm/parameters/adfr_auto_floor      1 = arm, 0 = off
+ *   /sys/module/msm_drm/parameters/adfr_auto_min_fps    fixed floor, 0 = table
+ * ---------------------------------------------------------------------------
+ */
+static unsigned int adfr_auto_floor;
+static unsigned int adfr_auto_min_fps;
+
+static int oplus_adfr_auto_floor_update(void *dsi_panel)
+{
+	struct dsi_panel *panel = dsi_panel;
+	struct dsi_display_mode_priv_info *priv_info = NULL;
+	struct oplus_adfr_params *p_oplus_adfr_params = NULL;
+	unsigned int refresh_rate = 120;
+	unsigned int min_fps = 0;
+	unsigned int table_count, table_first, table_last;
+
+	if (!adfr_auto_floor || !panel || !panel->cur_mode || !panel->cur_mode->priv_info)
+		return 0;
+
+	p_oplus_adfr_params = oplus_adfr_get_params(panel);
+	if (!p_oplus_adfr_params || !oplus_adfr_is_supported(p_oplus_adfr_params))
+		return 0;
+
+	priv_info = panel->cur_mode->priv_info;
+	table_count = priv_info->oplus_adfr_min_fps_mapping_table_count;
+	if (!table_count)
+		return 0;
+
+	refresh_rate = panel->cur_mode->timing.refresh_rate;
+	table_first = priv_info->oplus_adfr_min_fps_mapping_table[0];
+	table_last = priv_info->oplus_adfr_min_fps_mapping_table[table_count - 1];
+
+	if (adfr_auto_min_fps)
+		min_fps = adfr_auto_min_fps;
+	else
+		min_fps = oplus_adfr_get_sa_floor(panel);
+
+	if (!min_fps || min_fps > refresh_rate)
+		min_fps = refresh_rate;
+	if (min_fps < table_last)
+		min_fps = table_last;
+	if (min_fps > table_first)
+		min_fps = table_first;
+
+	if (p_oplus_adfr_params->auto_mode != OPLUS_ADFR_AUTO_ON) {
+		p_oplus_adfr_params->auto_mode = OPLUS_ADFR_AUTO_ON;
+		p_oplus_adfr_params->auto_mode_updated = true;
+		p_oplus_adfr_params->sa_min_fps_updated = true;
+	}
+
+	if (min_fps != p_oplus_adfr_params->sa_min_fps) {
+		p_oplus_adfr_params->sa_min_fps = min_fps;
+		p_oplus_adfr_params->sa_min_fps_updated = true;
+	}
+
+	ADFR_INFO("auto floor: refresh_rate:%u auto_min_fps:%u, auto_mode:%u\n",
+			refresh_rate, min_fps, p_oplus_adfr_params->auto_mode);
+
+	return 0;
+}
+
+static int oplus_adfr_auto_floor_set(const char *val, const struct kernel_param *kp)
+{
+	struct dsi_display *display = NULL;
+	unsigned int floor = 0;
+	int rc = 0;
+
+	rc = kstrtouint(val, 0, &floor);
+	if (rc)
+		return rc;
+
+	adfr_auto_floor = floor;
+
+	/* apply right away instead of waiting for the next timing switch */
+	display = oplus_display_get_current_display();
+	if (display && display->panel)
+		oplus_adfr_auto_floor_update(display->panel);
+
+	ADFR_INFO("adfr_auto_floor:%u\n", adfr_auto_floor);
+
+	return 0;
+}
+
+static const struct kernel_param_ops oplus_adfr_auto_floor_ops = {
+	.set = oplus_adfr_auto_floor_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(adfr_auto_floor, &oplus_adfr_auto_floor_ops, &adfr_auto_floor, 0644);
+MODULE_PARM_DESC(adfr_auto_floor, "Keep ADFR in auto mode with a low SA min-fps floor (kernel-side LTPO)");
+
+module_param(adfr_auto_min_fps, uint, 0644);
+MODULE_PARM_DESC(adfr_auto_min_fps, "Fixed SA min-fps floor used when adfr_auto_floor is armed (0 = backlight table)");
+
 /* reset adfr status as panel power on or timing switch */
 int oplus_adfr_status_reset(void *dsi_panel)
 {
@@ -1840,6 +2043,8 @@
 
 		p_oplus_adfr_params->sa_min_fps = refresh_rate;
 		p_oplus_adfr_params->sa_min_fps_updated = false;
+		oplus_adfr_sa_floor_update(panel, p_oplus_adfr_params->qsync_mode);
+	oplus_adfr_auto_floor_update(panel);
 		if (oplus_adfr_high_precision_sa_mode_is_enabled(p_oplus_adfr_params)) {
 			p_oplus_adfr_params->sa_high_precision_fps_updated = false;
 		}
@@ -2802,13 +3007,19 @@
 		ADFR_DEBUG("adfr is not supported\n");
 		return 0;
 	}
+	if (oplus_adfr_osync_params == OPLUS_ADFR_OSYNC_MODE)
